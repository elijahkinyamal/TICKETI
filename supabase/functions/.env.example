# Secrets for the Edge Functions (the BACKEND) — NOT the frontend .env.
#
# Local dev:  supabase functions serve --env-file supabase/functions/.env
# Production: set each with `supabase secrets set NAME=value`
#
# Note: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically in production — you only need them here for local serve.

# discovery-search — Ticketmaster Discovery API key (https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key

# send-transfer — Resend email (https://resend.com). Optional: without it the
# transfer is still recorded, just no email is sent.
RESEND_API_KEY=re_xxxxxxxx
TRANSFER_FROM_EMAIL=Eliki Tickets <onboarding@resend.dev>

# Base URL of the deployed app, used to build the "Accept your tickets" link.
APP_URL=https://your-app.vercel.app

# Only needed for local `functions serve` (auto-injected in production):
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
